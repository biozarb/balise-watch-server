node_modules/
.env

# SEC-A : fichiers d'audit/plan/prompt — jamais à committer publiquement
AUDIT_*.md
PLAN_*.md
PROMPT_*.md
LETTRE_*.md
MAIL_*.md

# Fichiers parasites de sessions/sondes (DIV-1)
.test_mf_tmp_UNUSED_ignore.js
newfile_probe.txt

# Python (py_compile / venv de test)
__pycache__/
*.pyc

# Cache local de compare_kk7.py — tuiles kk7 (CC-BY-NC-SA) et DEM.
# NE JAMAIS COMMITTER : republier les tuiles de M. von Känel dans un repo
# public serait exactement la redistribution que la licence encadre, et
# que le script prend soin d'éviter.
arome-thermal/.cache_kk7/

# Cache local de ingest_decos_pge.py — réponses brutes ParaglidingEarth
# (ODbL 1.0). Le fichier DÉRIVÉ (PWA/web/public/data/decos.json, juste
# des lat/lon) est volontairement commité — c'est ce cache-ci, la
# réponse API brute avec noms/altitudes/etc., qu'on ne republie pas.
arome-thermal/.cache_pge/

# Cache brut des scripts traces/ (fetch_syride.py, fetch_dhvxc.py,
# day_features.py) — vols et features individuels, jamais republiés
# tels quels (cf. PLAN_BATAILLE_TRACES_SOURCES.md). Seul le pack agrégé
# et anonymisé produit par build_site_pack.py (à écrire) sera commité.
traces/traces_cache/
traces/*.log

# Le journal de latence du poller — il vit sur le VPS
# (/var/lib/bw-model-verif/), il grossit de ~120 lignes par jour, et
# model-verif/latence/README.md dit comment le rapatrier.
model-verif/latence/agrume_latence.ndjson
model-verif/latence/runs_actions.json
