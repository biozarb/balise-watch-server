# ~/.balise-watch-r2.env  —  identifiants R2 du bucket des packs météo
#
# INSTALLATION (à faire une fois) :
#   cp balise-watch-r2.env.exemple ~/.balise-watch-r2.env
#   chmod 600 ~/.balise-watch-r2.env      ← NON NÉGOCIABLE
#   $EDITOR ~/.balise-watch-r2.env        ← y coller les vraies valeurs
#
# ⚠️ CE FICHIER-CI est un EXEMPLE versionné dans git. Il ne doit JAMAIS
#    contenir de valeur réelle. Le vrai fichier vit dans le home, hors
#    du repo, et n'y entre pas.
#
# Où retrouver ces valeurs : Cloudflare → R2 → API → « Jetons d'API du
# compte » → type Account, portée « Lecture/écriture OBJET » (surtout
# pas « administrateur », qui autorise la suppression de compartiments),
# restreinte au seul bucket balise-watch-packs.
# ⚠️ Pas via « Mon profil → Jetons API » : celui-là fabrique un Bearer,
#    pas des identifiants S3. Piège rencontré le 01/08/2026.

export R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export R2_BUCKET="balise-watch-packs"

# ── Réglages optionnels ──────────────────────────────────────────────
# Plafond d'appels pondérés Open-Meteo par run. L'entretien en consomme
# ~18 pour 210 décos (0,18 % du quota gratuit quotidien) : la valeur par
# défaut de 9000 est très large, on la laisse comme filet.
# export OM_MAX_WEIGHTED=9000
#
# Périmètre de bêta. Étendre = ajouter un code ici, rien d'autre — le
# checkpoint est idempotent, les décos déjà faits ne sont pas refaits.
# ⚠️ Les NOUVEAUX décos relèvent du backfill, pas de l'entretien : après
#    un élargissement, lancer un `--mode backfill --go` avant de laisser
#    l'entretien reprendre son cours.
# export BW_DEPARTEMENTS="66,73,38,74"

# ── Exécution (VPS) ──────────────────────────────────────────────────
# Le venv n'est PAS dans le PATH de cron : sans cette ligne, le run
# échoue avec « python3 introuvable » ou, pire, part sur le Python
# système qui n'a pas boto3.
# export BW_PYTHON="$HOME/venv-balise/bin/python3"

# ── Alertes ──────────────────────────────────────────────────────────
# Elles ne sont PAS configurées ici, mais dans un fichier séparé :
#     ~/.balise-watch-alertes.env   (cf. balise-watch-alertes.env.exemple)
#
# Raison : entretien.sh charge les alertes AVANT ce fichier-ci, parce
# que le premier échec possible du script est « .balise-watch-r2.env
# absent ». Une alerte configurée dans le fichier dont on signale
# l'absence ne partirait jamais.
