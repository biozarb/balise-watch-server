# ══════════════════════════════════════════════════════════════════════
#  bw-model-score.service — notation (réécrit le 07/08/2026)
#
#  Séparé de la collecte EXPRÈS : un bug dans la formule de score ne
#  doit jamais pouvoir empêcher ou corrompre la collecte, qui est la
#  seule pièce irremplaçable. Ce job-ci se rejoue sur l'archive autant
#  de fois qu'on veut (`run.sh score --day AAAA-MM-JJ`).
#
#  ⚠️ RÉÉCRIT APRÈS SONDAGE DU VPS (07/08) — mêmes trois corrections que
#  pour la collecte : chemins, utilisateur, et pas d'EnvironmentFile.
#
#  ⚠️ Ce job-ci a besoin de `SUPABASE_URL` et `SUPABASE_SERVICE_KEY`,
#  que la collecte n'utilise pas et qu'AUCUNE chaîne existante du VPS ne
#  possède. Elles vivent dans `~/.balise-watch-model-verif.env` (600),
#  chargé par `run.sh`. Sans elles, `run.sh` refuse de démarrer et le
#  dit — plutôt que de collecter proprement et de ne rien noter.
# ══════════════════════════════════════════════════════════════════════
[Unit]
Description=Balise Watch — notation des modèles (journée écoulée)
Documentation=file:/home/debian/balise-watch/balise-watch-server/model-verif/README.md
After=network-online.target bw-model-collect.service
Wants=network-online.target

[Service]
Type=oneshot
User=debian
Group=debian
WorkingDirectory=/home/debian/balise-watch/balise-watch-server/model-verif
ExecStart=/home/debian/balise-watch/balise-watch-server/model-verif/run.sh score
TimeoutStartSec=30min
Nice=10

# ── Cloisonnement, calqué sur balise-infoclimat.service ──────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/bw-model-verif
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# ⚠️ AJOUTÉ LOT E (08/08 soir) — absent depuis l'écriture du service,
# relevé par la revue du 08/08 et toujours vrai jusqu'ici (vérifié par
# `systemctl show … -p UMask` sur le VPS avant ce commit). 0077 : rien
# de lisible par le groupe ni par les autres sur les fichiers créés par
# ce service (état/écriture dans /var/lib/bw-model-verif).
UMask=0077

[Install]
WantedBy=multi-user.target
