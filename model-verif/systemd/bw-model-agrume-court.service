# ══════════════════════════════════════════════════════════════════════
#  bw-model-agrume-court.service — LA CLASSE COURTE (lot L10, 30/08/2026)
#
#  ⛔⛔ CETTE UNITÉ N'EST PAS INSTALLÉE. Elle est PROPOSÉE. Installer un
#  timer inédit reste une action de Yann, à la main, une fois — comme
#  pour toutes les autres unités de ce dossier, et comme
#  `deploy-agrume-vps.sh` le dit en toutes lettres à sa dernière ligne.
#
#  Ce qu'elle ferait : reconstituer, pour la journée ÉCOULÉE, ce qu'un
#  pilote pouvait savoir à 06:50 Z et à 12:50 Z — le meilleur produit
#  RÉELLEMENT disponible à ces instants, soit un AROME de la nuit
#  rafraîchi par un AROME-PI de l'heure d'avant — et l'archiver dans
#  `fcstagrumecourt/…`, que `bw-model-score` relira ensuite.
#
#  ⚠️ UNE UNITÉ À PART DE `bw-model-agrume`, ET POUR LA MÊME RAISON QUE
#  CELLE-CI EST À PART DE LA COLLECTE : les deux écrivent des clés
#  différentes, et le second ne doit pas pouvoir faire tomber le
#  premier. `fcstagrume_{J}` est l'archive de la classe +6 h ; un job
#  qui échouerait au milieu d'une écriture sur cette clé emporterait une
#  archive déjà bonne.
#
#  ⚠️ IL LIT `balise-watch-grids`, pas `model-verif` — même piège que
#  `bw-model-agrume`, même garde (`bucket_r2()` force la variable le
#  temps de la lecture et la restaure pour l'écriture).
#
#  ⚠️ Il exige numpy et boto3, qui vivent dans le venv désigné par
#  BW_PYTHON — pas dans le python3 système du VPS.
#
#  ⛔ IL NE PEUT PAS REMONTER LOIN. Les colonnes AROME sont purgées de
#  R2 au bout d'une semaine : un rejeu plus ancien ne PEUT pas savoir ce
#  qui était disponible à T. Le job le dit et n'écrit rien, plutôt que
#  d'inventer une disponibilité par une règle fixe.
# ══════════════════════════════════════════════════════════════════════
[Unit]
Description=Balise Watch — classe courte AGRUME (cadre 2, journée écoulée)
Documentation=file:/home/debian/balise-watch/balise-watch-server/model-verif/README.md
After=network-online.target
Wants=network-online.target
# Avant la notation, jamais après — et APRÈS `bw-model-agrume`, non par
# dépendance de données (les deux flux sont indépendants) mais pour ne
# pas lire R2 en même temps que lui.
After=bw-model-agrume.service
Before=bw-model-score.service

[Service]
Type=oneshot
User=debian
Group=debian
WorkingDirectory=/home/debian/balise-watch/balise-watch-server/model-verif
ExecStart=/home/debian/balise-watch/balise-watch-server/model-verif/run.sh agrume-court
TimeoutStartSec=15min
Nice=10

# ── Cloisonnement, calqué sur bw-model-agrume.service ────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/bw-model-verif
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
