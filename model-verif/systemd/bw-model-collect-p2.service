[Unit]
# bw-deploy: ne-pas-installer
#   ⓘ Lu par `tools/deploy-agrume-vps.sh` (§2 bis, lot LD du 31/08/2026).
#   Sans cette ligne, le contrôle « dépôt ↔ /etc » signalerait cette unité
#   comme MANQUANTE à chaque déploiement — alors que son absence est la
#   décision, écrite juste en dessous. Un contrôle qui crie au loup quatre
#   fois par passage se fait ignorer, et c'est ce silence-là qui a laissé
#   six unités disparaître. ⛔ Retirer cette ligne le jour où l'unité est
#   installée pour de bon — pas avant, pas après.
# ══════════════════════════════════════════════════════════════════════
#  bw-model-collect-p2 — la SECONDE passe de la collecte de prévisions
#                                       (lot S0.6, 22/08/2026)
#
#  ⛔ CETTE UNITÉ N'EST PAS À INSTALLER TANT QU'ELLE N'EST PAS NÉCESSAIRE.
#  Elle ACTIVE la partition, et l'activer coûte quelque chose : le groupe
#  de surface (sept modèles) passe de 03:19 à 04:35 UTC, ce qui peut lui
#  donner un run 00 Z plus frais du jour au lendemain. Le classement
#  bougerait alors sans qu'aucun modèle ait changé, et la fenêtre
#  glissante de 15 jours mélangerait les deux régimes pendant 15 jours.
#  ⇒ La date d'installation est une DÉCISION, et elle s'écrit dans la
#  note du lot. Cf. `claude/lot-s06-partition-passes-22-08.md`.
#
#  ═══ QUAND L'INSTALLER — DEUX DÉCLENCHEURS, LE PREMIER DES DEUX ═══
#
#  1. le référentiel approche des 775 points (la marge que
#     `quota_projete` écrit CHAQUE NUIT : « MARGE AVANT REFUS : N
#     points ») — au rythme mesuré, entre janvier et mai 2027 ;
#  2. ou l'on veut dépenser la place ouverte : la liste P1 porte le
#     référentiel à 965 points, soit 5 597 pondérés, et 5 597 ne
#     tiennent pas dans les 4 750 d'une fenêtre horaire.
#     ⇒ Vouloir P1, c'est vouloir cette unité d'abord.
#
#  ═══ POURQUOI 04:35 UTC, ET PAS 04:25 ═══
#
#  Mesuré le 22/08/2026 sur 14 nuits de `journalctl -u bw-model-collect`
#  et sur `/var/lib/bw-quota/openmeteo.json` (1 077 événements) :
#
#   · la passe de prévisions démarre entre 03:15:40 et 03:19:49 UTC
#     (`OnCalendar=03:15` + `RandomizedDelaySec=300`) ;
#   · elle FINIT ses appels Open-Meteo entre 03:24:08 et 03:28:02 — pire
#     cas mesuré sur 14 nuits : 03:28:02, le 22/08 ;
#   · réduite au seul groupe d'ALTITUDE (1 051 pondérés au lieu de
#     4 730), elle durera ~2 min au lieu de ~9 : sa queue tombe donc
#     plutôt vers 03:22 ;
#   · un événement sort de la fenêtre GLISSANTE une heure après avoir
#     été posé ⇒ l'heure de la passe 1 est rendue au plus tard à 04:28,
#     et en régime nominal vers 04:22 ;
#   · `balise-entretien.timer` fait tourner `backfill_packs` de 04:30 à
#     04:34 UTC pour 252,0 pondérés (mesuré les 21 ET 22/08). À 04:35 il
#     a fini — et même s'il débordait, 252 + 4 053 (passe de surface à
#     965 points) = 4 305, sous les 4 750 ;
#   · `bw-model-score` tombe à 03:55 et note LA VEILLE (vérifié dans
#     `score.py::main`) : une archive écrite à 04:35 le jour J est lue
#     par la notation du jour J+1, 23 h plus tard. Aucune interaction.
#
#  ⇒ 04:35 laisse 7 minutes de marge sur le pire cas mesuré, et 13 sur
#  le régime nominal. `RandomizedDelaySec=60` et pas 300 : la fenêtre
#  est choisie précisément, une gigue de 5 min la rendrait floue.
#
#  ⚠️ ET LE PIRE CAS NON MESURÉ RESTE COUVERT. Si la passe 1 déborde
#  jusqu'à son chien de garde (40 min), son heure n'est rendue qu'à
#  05:00. `collect.py::attendre_la_place` le DEMANDE au budget partagé
#  au lieu de le supposer, et DORT UNE FOIS, de façon bornée
#  (`ATTENTE_PASSE_MAX_S` = 25 min), au lieu de se faire refuser point
#  par point. Au-delà de la borne, la passe est sautée et le manifeste
#  dit laquelle.
# ══════════════════════════════════════════════════════════════════════
Description=Balise Watch — collecte de prévisions, passe 2 (groupe de surface)
Documentation=file:///home/debian/balise-watch/balise-watch-server/model-verif/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=debian
# ⚠️ AUCUN `--passe 2` ICI, ET C'EST VOULU. Le drapeau est dérivé du
# MODE par `run.sh` (tableau `EXTRA`). Une unité qui le porterait
# pourrait être réinstallée sans lui — et la passe 2 collecterait alors
# les NEUF modèles à 04:35, dans une archive qui porterait deux fois les
# mêmes lignes sous deux clés. Le mode et son drapeau ne se séparent pas.
ExecStart=/home/debian/balise-watch/balise-watch-server/model-verif/run.sh collect-p2
# 50 min > les 40 du chien de garde de `run.sh` : on veut que ce soit
# `run.sh` qui constate l'échec et alerte, pas systemd qui tue tout sans
# que personne ne l'apprenne.
TimeoutStartSec=50min

[Install]
WantedBy=multi-user.target
